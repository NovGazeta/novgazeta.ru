---
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site";
import { rubricHref, getCategoryList, getFeatured, visiblePosts } from "@/lib/posts";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = visiblePosts(await getCollection("articles"));
const allPosts = visiblePosts(await getCollection("posts"));
const [latest, ...rest] = allPosts;
const feed = rest.slice(0, 8);
const featured = getFeatured(allPosts, 4).filter((post) => post.id !== latest?.id);
const categoryList = getCategoryList(posts);
const hasMore = rest.length > feed.length;
---

<BaseLayout>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="inner">
      <h1 class="sr-only">
        {siteConfig.name} — {siteConfig.tagline}
      </h1>

      {latest && (
        <section class="pt-10 pb-[var(--space-section)] md:pt-14" aria-label="Latest post">
          <PostCard post={latest} variant="lead" headingLevel="h2" dateLabel="Latest" />
        </section>
      )}

      <div class="grid gap-[var(--space-section)] lg:grid-cols-[minmax(0,4fr)_minmax(0,2fr)] lg:gap-12">
        <section aria-labelledby="more-posts">
          <h2 id="more-posts" class="section-title">
            Статьи
          </h2>

          {feed.length > 0 ? (
            <div class="feed">
              {feed.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <p class="text-muted-foreground">Скоро...</p>
          )}

          {hasMore && (
            <a href="/posts/" class="btn btn-outline btn-block mt-16">
              Все статьи
            </a>
          )}
        </section>

        <aside class="sidebar">
          {featured.length > 0 && (
            <section aria-labelledby="featured-heading">
              <h2 id="featured-heading" class="section-title">
                Интересное
              </h2>
              <div class="grid gap-7">
                {featured.map((post) => (
                  <PostCard post={post} variant="compact" headingLevel="h3" />
                ))}
              </div>
            </section>
          )}

          {categoryList.length > 0 && (
            <section aria-labelledby="categories-heading">
              <h2 id="categories-heading" class="section-title">
                Разделы
              </h2>
              <ul class="grid gap-4">
                {categoryList.map((category) => (
                  <li>
                    <a
                      href={rubricHref(category.name)}
                      class="link-title flex items-center justify-between gap-3"
                    >
                      <span class="link-title__text text-base font-semibold tracking-tight">
                        {category.name}
                      </span>
                      <span class="pill shrink-0">
                        {category.count}{" "}
                        {category.count === 1 ? "статья" : category.count < 5 ? "статьи" : "статей"}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
