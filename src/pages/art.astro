---
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

//const articles = await getCollection("articles");
//console.log(articles);

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout title="О сайте">
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">О сайте</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>What gets published here</h2>
        <p>
          Long-form notes on building software: the decision behind a change, what it cost, and what
          would be done differently next time. Posts are written to be read once, carefully, rather
          than skimmed.
        </p>

        <h2>Авторы</h2>
        <ul>
          {authors.map((author) => (
            <li>
              <a href={`/author/${authorSlug(author.name)}/`}>{author.name}</a> — {author.role} (
              {author.posts.length} {author.posts.length === 1 ? "post" : "posts"})
            </li>
          ))}
        </ul>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
